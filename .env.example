# Copy to .env and fill in your own values. NEVER commit your real .env!

# Pick one provider: claude (default) | openai | groq | gemini
AI_PROVIDER=claude

# --- Anthropic Claude (recommended) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional; default is claude-sonnet-4-6
# AI_MODEL=claude-sonnet-4-6

# --- OpenAI (pay-per-token, needs prepaid billing credit) ---
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-5-mini

# --- Groq (FREE tier, no credit card - ~14,400 requests/day) ---
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (FREE tier, no credit card - ~1,500 requests/day) ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# Override the server port (default 8787)
PORT=8787

# Vercel frontend only: set this to the public Render backend URL, for example
# VITE_AI_API_URL=https://football-iq-arena-api.onrender.com
